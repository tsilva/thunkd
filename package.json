{
  "name": "thunkd",
  "version": "1.0.0",
  "packageManager": "pnpm@10.27.0",
  "main": "expo-router/entry",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "start": "node scripts/dev-server.mjs expo start",
    "android": "node scripts/dev-server.mjs expo start --android",
    "ios": "node scripts/dev-server.mjs expo start --ios",
    "security:test": "node scripts/security/image-size-regression.mjs && node scripts/security/nyc-config-regression.mjs && node scripts/security/forge-braces-regression.mjs",
    "web": "node scripts/dev-server.mjs expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.1",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.29.0": "7.29.7",
      "brace-expansion@1.1.14": "1.1.21",
      "brace-expansion@2.1.0": "2.1.7",
      "brace-expansion@5.0.5": "5.0.12",
      "fast-uri@3.1.0": "3.1.8",
      "js-yaml@3.14.2": "3.15.2",
      "js-yaml@4.1.1": "4.3.2",
      "nanoid@3.3.11": "3.3.18",
      "postcss@8.4.49": "8.5.26",
      "shell-quote": "1.11.0",
      "tar": "7.5.22",
      "undici@6.25.0": "6.28.1",
      "uuid@7.0.3": "11.1.1",
      "ws": "8.21.2",
      "source-map-js": "1.2.2",
      "compression": "1.8.2",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "baseline-browser-mapping@<2.11.0": "2.11.27",
      "browserslist@<4.28.7": "4.28.9",
      "@humanfs/node@<0.16.8": "0.16.8",
      "decode-uri-component": "0.5.0",
      "@istanbuljs/load-nyc-config@1.1.0>js-yaml": "4.3.2"
    },
    "patchedDependencies": {
      "image-size@1.2.1": "patches/image-size@1.2.1.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  },
  "private": true
}
